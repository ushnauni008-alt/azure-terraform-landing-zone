# Terraform local working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Variable files - may contain sensitive/environment-specific values
*.tfvars
*.tfvars.json

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform transient lock file
.terraform.tfstate.lock.info

# Terraform plan files
*.tfplan
tfplan
tfplan.txt

# Terraform CLI configuration
.terraformrc
terraform.rc

# Infracost generated files
.infracost/
infracost-base.json